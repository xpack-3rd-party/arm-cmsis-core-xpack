          ],
          "sourceFiles": [],
          "publicDefines": [
            "__PROGRAM_START"
          ],
          "dependencies": [],
          // "customDefine": "XPACK_3RD_PARTY_ARM_CMSIS_CORE_CORTEX_A_ENABLED"
        }
      ]
    }
